# This file is for local development using `netlify dev`.
# These variables will be loaded into your environment.
# Do NOT commit this file to GitHub.

# Your Stripe API keys (from stripe.com/dashboard/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# The URL of your local development server (usually http://localhost:8888)
SITE_URL="http://localhost:8888"

# The webhook signing secret from your local Stripe CLI or test webhook endpoint
STRIPE_WEBHOOK_SECRET="whsec_..."

# Your Zoho API key for sending emails
ZOHO_API_KEY="Your-Zoho-ZeptoMail-API-Key"

# Path to your Firebase service account JSON file for the Admin SDK
GOOGLE_APPLICATION_CREDENTIALS="./path/to/your/firebase-service-account.json"